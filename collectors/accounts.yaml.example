    business: personal
    label: personal inbox
    calendars: [primary]

  - email: margaret@mytherapywellness.com
    business: atwc
    label: ATWC inbox
    calendars: [primary]

  - email: margarets@qcaroofing.com
    business: qca
    label: QCA inbox
    calendars: [primary]
