# Copy to .env and fill in. Never commit .env.

# Where this repo lives on the machine that runs Hermes and the collectors
JARVIS_HOME=/home/margaret/Jarvis

# Home timezone for briefs and the dashboard (IANA name)
JARVIS_TZ=America/Chicago

# Google: one OAuth client (Desktop app type) from console.cloud.google.com.
# Every email account you connect signs in through this same client.
GOOGLE_CLIENT_SECRET_FILE=collectors/credentials/client_secret.json

# Asana personal access token (app.asana.com > My Settings > Apps > Developer apps)
ASANA_TOKEN=

# Airtable personal access token with data.records:read on ATWC Ops and Permit Tracker
AIRTABLE_TOKEN=
AIRTABLE_ATWC_BASE=appKWU9ggxyVYvs2g
AIRTABLE_ATWC_WAITLIST_TABLE=tblnwneQqlChWi8ks
AIRTABLE_QCA_BASE=appkWXOY6hM0pxT76
AIRTABLE_QCA_WIP_TABLE=tblX1WhjyrukQulfC

# YouTube Data API key (for the content scout). Same Google Cloud project is fine.
YOUTUBE_API_KEY=

# Where Hermes delivers briefs. Set by `hermes gateway` pairing; kept here for reference.
HERMES_DELIVER=telegram
